# ---------------------------------------------------------------------------
# Urbania Cabs Bangalore - environment variables
#
# Copy this file to .env for local development and add the same values in
# Vercel: Project -> Settings -> Environment Variables.
#
# Never commit .env and never put any of these values in index.html or
# assets/js/main.js. The Google key is used only by /api/places on the server.
# ---------------------------------------------------------------------------

# Telegram team notifications (optional but recommended).
# 1. Create a bot with @BotFather and copy the bot token.
# 2. Add the bot to the private team chat or group.
# 3. Get the chat ID (for a group, it usually starts with a minus sign).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Places address suggestions (optional).
# Enable "Places API (New)" in Google Cloud, create a server-side API key,
# and restrict the key to that API. Do not expose this key in the browser.
GOOGLE_MAPS_API_KEY=

# Optional alias accepted by api/places.js if you prefer this name.
# GOOGLE_PLACES_API_KEY=
